        "updated_at": "2026-07-19T10:00:00",
        "body": "<section class='mx-auto max-w-3xl px-5 py-14'> <h1 class='text-3xl font-bold text-slate-900'>Contact</h1> <div class='mt-6 grid gap-4 sm:grid-cols-2'> <div class='rounded-2xl border border-slate-200 bg-white p-5'><div class='text-xs uppercase tracking-wide text-slate-400'>WhatsApp</div><div class='mt-1 font-medium text-slate-900'>+{{ settings.whatsapp }}</div></div> <div class='rounded-2xl border border-slate-200 bg-white p-5'><div class='text-xs uppercase tracking-wide text-slate-400'>Email</div><div class='mt-1 font-medium text-slate-900'>{{ settings.email }}</div></div> <div class='rounded-2xl border border-slate-200 bg-white p-5'><div class='text-xs uppercase tracking-wide text-slate-400'>Telegram</div><div class='mt-1 font-medium text-slate-900'>@{{ settings.telegram }}</div></div> <div class='rounded-2xl border border-slate-200 bg-white p-5'><div class='text-xs uppercase tracking-wide text-slate-400'>Address</div><div class='mt-1 font-medium text-slate-900'>{{ settings.address }}</div></div> </div> <div class='mt-8 rounded-2xl border border-slate-200 bg-white p-5' data-signals='{qty:1}'> <div class='text-sm text-slate-600'>Datastar demo — compute a total without a reload ($149.00 each):</div> <div class='mt-3 flex items-center gap-3'> <button type='button' class='h-9 w-9 rounded-lg border border-slate-200 text-lg leading-none hover:bg-slate-50' data-on:click='$qty = Math.max(1, $qty - 1)'>−</button> <input type='number' class='w-16 rounded-lg border border-slate-200 px-2 py-1 text-center' data-bind='qty'> <button type='button' class='h-9 w-9 rounded-lg border border-slate-200 text-lg leading-none hover:bg-slate-50' data-on:click='$qty = $qty + 1'>+</button> <span class='font-semibold text-slate-900' data-text=\"'Total: $' + ($qty * 149).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})\"></span> </div> </div> </section>"
    }
]