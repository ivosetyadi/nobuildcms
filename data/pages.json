        "updated_at": "2026-07-08T10:00:00",
        "body": "<section class='mx-auto max-w-6xl px-5 py-12'> <div class='overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-700 px-8 py-16 text-white'> <span class='inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-medium'><span class='h-2 w-2 rounded-full bg-emerald-400'></span> Live</span> <h1 class='mt-5 text-4xl font-bold leading-tight md:text-5xl'>{{ settings.site_name }}<br>{{ settings.tagline }}</h1> <p class='mt-4 max-w-xl text-indigo-100'>Hi {{ visitor.name }}! This page is rendered from a JSON record through a Twig template. Edit a title, price, or body in the dashboard and watch this page change without a reload.</p> <div class='mt-8 flex flex-wrap gap-3'> <a href='/products' class='rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100'>View products</a> <a href='/blog' class='rounded-xl bg-white/10 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/20'>Read articles</a> <a href='/admin' class='rounded-xl px-5 py-2.5 text-sm font-semibold text-indigo-100 hover:text-white'>Open dashboard →</a> </div> </div> <div class='mt-8 grid grid-cols-3 gap-4'> <div class='rounded-2xl border border-slate-200 bg-white p-5 text-center'><div class='text-xs uppercase tracking-wide text-slate-500'>Articles</div><div class='mt-1 text-3xl font-bold text-slate-900'>{{ collection('posts')|length }}</div></div> <div class='rounded-2xl border border-slate-200 bg-white p-5 text-center'><div class='text-xs uppercase tracking-wide text-slate-500'>Products</div><div class='mt-1 text-3xl font-bold text-slate-900'>{{ collection('products')|length }}</div></div> <div class='rounded-2xl border border-slate-200 bg-white p-5 text-center'><div class='text-xs uppercase tracking-wide text-slate-500'>Pages</div><div class='mt-1 text-3xl font-bold text-slate-900'>{{ collection('pages', {status:'*'})|length }}</div></div> </div> <h2 class='mt-14 text-xl font-bold text-slate-900'>Featured products</h2> <p class='mt-1 text-sm text-slate-500'>collection('products', where attrs.featured = true)</p> <div class='mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4'> {% for p in collection('products', {where:{'attrs.featured':true}, limit:4}) %} <a href='{{ p.url }}' class='group rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm'> <div class='text-3xl'>{{ p.attrs.emoji|default('📦') }}</div> <div class='mt-3 text-xs uppercase tracking-wide text-slate-400'>{{ p.attrs.category }}</div> <div class='font-semibold text-slate-900'>{{ p.title }}</div> <div class='mt-1 text-sm text-slate-500'>{{ p.attrs.price|money }} · {% if p.attrs.stock > 0 %}{{ p.attrs.stock }} in stock{% else %}<span class='text-rose-500'>Sold out</span>{% endif %}</div> </a> {% endfor %} </div> <h2 class='mt-14 text-xl font-bold text-slate-900'>Latest articles</h2> <div class='mt-5 grid gap-4 md:grid-cols-3'> {% for a in collection('posts', {sort:'-created_at', limit:3}) %} <a href='{{ a.url }}' class='rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300'> <div class='text-xs text-slate-400'>{{ a.created_at|fdate('d M Y') }}</div> <div class='mt-1 font-semibold text-slate-900'>{{ a.title }}</div> <p class='mt-1 text-sm text-slate-500'>{{ a.excerpt }}</p> </a> {% endfor %} </div> </section>"
    },
    {
