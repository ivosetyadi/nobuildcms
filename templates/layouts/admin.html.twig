<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default('Dashboard') ~ ' · ' ~ settings.site_name }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script type="module" src="/assets/datastar.js"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <div class="flex min-h-screen">
        <aside class="hidden w-64 shrink-0 flex-col border-r border-slate-200 bg-white md:flex">
            <div class="flex items-center gap-2 px-5 py-4 font-bold">
                <span class="grid h-7 w-7 place-items-center rounded-lg bg-indigo-600 text-white">✳</span>
                {{ settings.site_name }}
            </div>
            <nav class="flex-1 space-y-1 px-3 py-2 text-sm">
                <div class="px-2 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Utama</div>
                <a href="/admin" class="block rounded-lg px-3 py-2 {{ active == 'home' ? 'bg-indigo-50 font-medium text-indigo-700' : 'text-slate-700 hover:bg-slate-50' }}">Ringkasan</a>
                <div class="px-2 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Konten</div>
                {% for t, lbl in types %}
                    <a href="/admin/content/{{ t }}" class="block rounded-lg px-3 py-2 {{ active == t ? 'bg-indigo-50 font-medium text-indigo-700' : 'text-slate-700 hover:bg-slate-50' }}">{{ lbl }}</a>
                {% endfor %}
                <div class="px-2 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Sistem</div>
                <a href="/admin/settings" class="block rounded-lg px-3 py-2 {{ active == 'settings' ? 'bg-indigo-50 font-medium text-indigo-700' : 'text-slate-700 hover:bg-slate-50' }}">Pengaturan</a>
                <a href="/" target="_blank" class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-50">Lihat situs ↗</a>
            </nav>
            <div class="border-t border-slate-200 px-5 py-3 text-sm">
                <div class="font-medium">{{ user.name }}</div>
                <div class="text-xs text-slate-500">{{ user.email }} · {{ user.role }}</div>
                <a href="/admin/logout" class="mt-1 inline-block text-xs text-rose-600 hover:underline">Keluar</a>
            </div>
        </aside>

        <div class="flex-1">
            <header class="flex items-center justify-between border-b border-slate-200 bg-white px-6 py-4">
                <div>
                    <h1 class="text-lg font-bold">{{ title|default('Ringkasan') }}</h1>
                    <p class="text-sm text-slate-500">{{ subtitle|default('') }}</p>
                </div>
                {% block actions %}{% endblock %}
            </header>
            <div class="p-6">{% block main %}{% endblock %}</div>
        </div>
    </div>
</body>
</html>
