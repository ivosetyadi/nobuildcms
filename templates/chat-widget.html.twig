<div data-signals="{chatOpen: false, draft: ''}" class="fixed bottom-5 right-5 z-30">
    <button type="button" data-show="!$chatOpen" data-on:click="$chatOpen = true; @get('/chat/poll')" style="display:none" class="grid h-14 w-14 place-items-center rounded-full bg-indigo-600 text-2xl shadow-lg transition hover:bg-indigo-500">💬</button>

    <div data-show="$chatOpen" style="display:none" class="flex h-96 w-80 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
            <div class="text-sm font-semibold text-slate-900">Lobby chat</div>
            <button type="button" data-on:click="$chatOpen = false" class="text-slate-400 hover:text-slate-700">✕</button>
        </div>
        <div id="chat-messages" data-on-interval__duration.3s="@get('/chat/poll')" class="flex-1 divide-y divide-slate-100 overflow-y-auto">
            <div class="py-10 text-center text-sm text-slate-400">Loading…</div>
        </div>
        <form class="flex items-center gap-2 border-t border-slate-200 p-3" data-on:submit="@post('/chat/send')">
            <input data-bind="draft" autocomplete="off" placeholder="Type a message…" class="flex-1 rounded-lg border border-slate-200 px-3 py-1.5 text-sm outline-none focus:border-indigo-400">
            <button class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-500">Send</button>
        </form>
    </div>
</div>
