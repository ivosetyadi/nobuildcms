<span id="title-{{ r.id }}">
    <form class="inline-flex items-center gap-1" data-on:submit="@post('/admin/content/{{ type }}/rename?id={{ r.id }}', {contentType:'form'})">
        <input name="title" value="{{ r.title }}" autofocus class="w-56 rounded-lg border border-indigo-300 px-2 py-1 text-sm outline-none">
        <button class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500">✓</button>
        <button type="button" class="rounded px-2 py-1 text-xs text-slate-500 hover:text-slate-800" data-on:click="@get('/admin/content/{{ type }}/inline?id={{ r.id }}&cancel=1')">✕</button>
    </form>
</span>
