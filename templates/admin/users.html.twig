{% extends 'layouts/admin.html.twig' %}
{% block main %}
    <div class="mx-auto max-w-5xl space-y-6">
        <form method="post" action="/admin/users/save" class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="mb-3 font-semibold">Add user</h2>
            <div class="grid gap-3 sm:grid-cols-5">
                <input name="name" placeholder="Name" required class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                <input name="email" type="email" placeholder="Email" required class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                <input name="password" type="password" placeholder="Password" required class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                <select name="role" class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                    <option value="viewer">Viewer</option>
                    <option value="editor">Editor</option>
                    <option value="owner">Owner</option>
                </select>
                <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="active" checked> Active</label>
            </div>
            <div class="mt-3 text-right"><button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Add user</button></div>
        </form>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <table class="w-full text-sm">
                <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Name</th>
                        <th class="px-5 py-3 font-medium">Email</th>
                        <th class="px-5 py-3 font-medium">Last login</th>
                        <th class="px-5 py-3 font-medium text-right">Role &amp; actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for u in users %}
                        <tr class="align-top">
                            <td class="px-5 py-3 font-medium">{{ u.name }}{% if u.id == user.id %} <span class="text-xs text-slate-400">(you)</span>{% endif %}</td>
                            <td class="px-5 py-3 text-slate-600">{{ u.email }}</td>
                            <td class="px-5 py-3 text-slate-500">{{ u.last_login ? (u.last_login|fdate('d M Y, H:i')) : 'never' }}</td>
                            <td class="px-5 py-3">
                                <form method="post" action="/admin/users/save" class="flex items-center justify-end gap-2">
                                    <input type="hidden" name="id" value="{{ u.id }}">
                                    <input type="hidden" name="name" value="{{ u.name }}">
                                    <input type="hidden" name="email" value="{{ u.email }}">
                                    <select name="role" class="rounded-lg border border-slate-200 px-2 py-1 text-xs">
                                        {% for r in ['owner', 'editor', 'viewer'] %}<option value="{{ r }}" {{ u.role == r ? 'selected' : '' }}>{{ r|capitalize }}</option>{% endfor %}
                                    </select>
                                    <label class="text-xs text-slate-600"><input type="checkbox" name="active" {{ u.active ? 'checked' : '' }}> active</label>
                                    <input name="password" type="password" placeholder="reset pw" class="w-24 rounded-lg border border-slate-200 px-2 py-1 text-xs">
                                    <button class="rounded-lg bg-indigo-600 px-2 py-1 text-xs font-semibold text-white hover:bg-indigo-500">Save</button>
                                </form>
                                {% if u.id != user.id %}
                                    <form method="post" action="/admin/users/delete" onsubmit="return confirm('Delete {{ u.name }}?')" class="mt-1 text-right">
                                        <input type="hidden" name="id" value="{{ u.id }}">
                                        <button class="text-xs text-rose-600 hover:underline">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
