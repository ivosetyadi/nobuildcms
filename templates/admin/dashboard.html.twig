{% extends 'layouts/admin.html.twig' %}
{% block main %}
    <div class="grid grid-cols-3 gap-4">
        {% for t, lbl in types %}
            <a href="/admin/content/{{ t }}" class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300">
                <div class="text-xs uppercase tracking-wide text-slate-500">{{ lbl }}</div>
                <div class="mt-1 text-3xl font-bold">{{ counts[t]|default(0) }}</div>
            </a>
        {% endfor %}
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
            <h2 class="font-semibold">Recently updated articles</h2>
            <a href="/admin/content/posts" class="text-sm text-indigo-600 hover:underline">View all</a>
        </div>
        <ul class="divide-y divide-slate-100">
            {% for r in recent %}
                <li class="flex items-center justify-between px-5 py-3">
                    <div>
                        <a href="/admin/content/posts/edit?id={{ r.id }}" class="font-medium hover:text-indigo-600">{{ r.title }}</a>
                        <div class="text-xs text-slate-400">{{ r.slug }}</div>
                    </div>
                    <span class="rounded-full px-2 py-0.5 text-xs {{ r.status == 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' }}">{{ r.status == 'published' ? 'Published' : 'Draft' }}</span>
                </li>
            {% else %}
                <li class="px-5 py-6 text-center text-sm text-slate-400">No articles yet.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
