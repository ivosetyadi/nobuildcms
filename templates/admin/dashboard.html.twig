{% extends 'layouts/admin.html.twig' %}
{% set colors = {'pages': '#6366f1', 'posts': '#10b981', 'products': '#f59e0b'} %}
{% block main %}
    {# Stat cards #}
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {% for t, lbl in types %}
            <a href="/admin/content/{{ t }}" class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300">
                <div class="text-xs uppercase tracking-wide text-slate-500">{{ lbl }}</div>
                <div class="mt-1 text-3xl font-bold">{{ counts[t]|default(0) }}</div>
            </a>
        {% endfor %}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="text-xs uppercase tracking-wide text-slate-500">Total reads</div>
            <div class="mt-1 text-3xl font-bold">{{ total_reads|number_format(0, '.', ',') }}</div>
            <div class="mt-1 text-xs text-slate-400">{{ published }} published</div>
        </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
        {# Composition donut #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Content composition</h2>
            <div class="mt-4 flex items-center gap-6">
                <div class="relative h-40 w-40">
                    <svg viewBox="0 0 128 128" class="h-40 w-40 -rotate-90">
                        <circle cx="64" cy="64" r="56" fill="none" stroke="#e2e8f0" stroke-width="16"></circle>
                        {% for s in segs %}
                            <circle cx="64" cy="64" r="56" fill="none" stroke="{{ colors[s.key] }}" stroke-width="16" pathLength="100" stroke-dasharray="{{ s.pct }} 100" stroke-dashoffset="{{ -s.off }}"></circle>
                        {% endfor %}
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <div class="text-2xl font-bold">{{ total }}</div>
                        <div class="text-xs text-slate-400">items</div>
                    </div>
                </div>
                <ul class="space-y-2 text-sm">
                    {% for s in segs %}
                        <li class="flex items-center gap-2">
                            <span class="h-3 w-3 rounded-full" style="background: {{ colors[s.key] }}"></span>
                            <span class="capitalize text-slate-700">{{ s.key }}</span>
                            <span class="text-slate-400">{{ s.count }} · {{ s.pct }}%</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        {# Popular content #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Most read</h2>
            <ul class="mt-3 space-y-2 text-sm">
                {% for r in popular %}
                    {% set max = popular[0].reads|default(1) %}
                    <li>
                        <div class="flex items-center justify-between">
                            <span class="truncate text-slate-700">{{ r.title }}</span>
                            <span class="ml-2 shrink-0 text-xs text-slate-400">{{ r.reads|default(0)|number_format(0, '.', ',') }}</span>
                        </div>
                        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                            <div class="h-full rounded-full bg-indigo-500" style="width: {{ max > 0 ? (r.reads|default(0) / max * 100)|round : 0 }}%"></div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {# Low stock #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Lowest stock</h2>
            <ul class="mt-3 divide-y divide-slate-100 text-sm">
                {% for p in low_stock %}
                    <li class="flex items-center justify-between py-2">
                        <span class="text-slate-700">{{ p.attrs.emoji|default('📦') }} {{ p.title }}</span>
                        <span class="rounded-full px-2 py-0.5 text-xs {{ (p.attrs.stock|default(0)) > 0 ? 'bg-slate-100 text-slate-600' : 'bg-rose-50 text-rose-700' }}">{{ p.attrs.stock|default(0) }}</span>
                    </li>
                {% else %}
                    <li class="py-4 text-center text-slate-400">No products.</li>
                {% endfor %}
            </ul>
        </div>

        {# Activity feed #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <h2 class="font-semibold">Recent activity</h2>
                {% if user.role == 'owner' %}<a href="/admin/audit" class="text-sm text-indigo-600 hover:underline">Audit log</a>{% endif %}
            </div>
            <ul class="mt-3 space-y-3 text-sm">
                {% for e in activity %}
                    <li class="flex items-start gap-2">
                        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-indigo-400"></span>
                        <div>
                            <div><code class="text-xs text-slate-600">{{ e.action }}</code> <span class="text-slate-400">{{ e.resource }}</span></div>
                            <div class="text-xs text-slate-400">{{ e.actor_name|default(e.actor) }} · {{ e.ts|fdate('d M, H:i') }}</div>
                        </div>
                    </li>
                {% else %}
                    <li class="py-4 text-center text-slate-400">No activity yet — actions will appear here.</li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
