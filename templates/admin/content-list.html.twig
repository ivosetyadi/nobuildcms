{% extends 'layouts/admin.html.twig' %}
{% block actions %}
    {% if user.role != 'viewer' %}
        <button type="button" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" data-on:click="$drawerOpen = true; @get('/admin/content/{{ type }}/edit')">+ New {{ label }}</button>
    {% endif %}
{% endblock %}
{% block main %}
    <div data-signals="{drawerOpen: false, q: '', status: 'all', sort: '-updated_at', sel: []}">
        {% if user.role != 'viewer' %}
            <div data-show="$sel.length > 0" style="display:none" class="mb-3 flex flex-wrap items-center gap-2 rounded-lg bg-indigo-50 px-4 py-2 text-sm">
                <span class="font-medium text-indigo-700"><span data-text="$sel.length">0</span> selected</span>
                <button type="button" class="rounded-md bg-white px-3 py-1 text-slate-700 hover:bg-slate-50" data-on:click="@post('/admin/content/{{ type }}/bulk?do=publish')">Publish</button>
                <button type="button" class="rounded-md bg-white px-3 py-1 text-slate-700 hover:bg-slate-50" data-on:click="@post('/admin/content/{{ type }}/bulk?do=draft')">Draft</button>
                <button type="button" class="rounded-md bg-white px-3 py-1 text-rose-600 hover:bg-slate-50" data-on:click="confirm('Move selected to trash?') && @post('/admin/content/{{ type }}/bulk?do=trash')">Trash</button>
                <button type="button" class="ml-auto text-slate-500 hover:text-slate-800" data-on:click="$sel = []">Clear</button>
            </div>
        {% endif %}
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <input data-bind="q" data-on:input__debounce.300ms="@get('/admin/content/{{ type }}')" placeholder="Search title, slug, tag…" class="w-64 rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
            <div class="flex rounded-lg border border-slate-200 bg-white p-0.5 text-sm">
                {% for s in [['all', 'All'], ['published', 'Published'], ['draft', 'Draft']] %}
                    <button type="button" data-on:click="$status = '{{ s[0] }}'; @get('/admin/content/{{ type }}')" data-class="{'bg-indigo-50 text-indigo-700 font-medium': $status == '{{ s[0] }}'}" class="rounded-md px-3 py-1 text-slate-600">{{ s[1] }}</button>
                {% endfor %}
            </div>
            <select data-bind="sort" data-on:change="@get('/admin/content/{{ type }}')" class="rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                <option value="-updated_at">Recently updated</option>
                <option value="-created_at">Newest</option>
                <option value="title">Title A–Z</option>
                <option value="-reads">Most read</option>
            </select>
        </div>

        {% include 'admin/content-table.html.twig' %}

        {# Off-canvas editor drawer #}
        <div data-show="$drawerOpen" class="fixed inset-0 z-40" style="display:none">
            <div class="absolute inset-0 bg-slate-900/40" data-on:click="$drawerOpen = false"></div>
            <div class="absolute right-0 top-0 h-full w-full max-w-xl bg-white shadow-xl">
                <div id="drawer-body" class="flex h-full items-center justify-center text-sm text-slate-400">Loading…</div>
            </div>
        </div>
    </div>
{% endblock %}
