{% extends 'layouts/admin.html.twig' %}
{% block actions %}
    {% if user.role != 'viewer' %}
        <button type="button" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" data-on:click="$drawerOpen = true; @get('/admin/content/{{ type }}/edit')">+ New {{ label }}</button>
    {% endif %}
{% endblock %}
{% block main %}
    <div data-signals="{drawerOpen: false}">
        {% include 'admin/content-table.html.twig' %}

        {# Off-canvas editor drawer #}
        <div data-show="$drawerOpen" class="fixed inset-0 z-40" style="display:none">
            <div class="absolute inset-0 bg-slate-900/40" data-on:click="$drawerOpen = false"></div>
            <div class="absolute right-0 top-0 h-full w-full max-w-xl bg-white shadow-xl">
                <div id="drawer-body" class="flex h-full items-center justify-center text-sm text-slate-400">Loading…</div>
            </div>
        </div>
    </div>
{% endblock %}
