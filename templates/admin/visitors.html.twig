{% extends 'layouts/admin.html.twig' %}
{% block main %}
    <div class="mb-4 flex gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4">
            <div class="flex items-center gap-2 text-xs uppercase tracking-wide text-slate-500"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Online now</div>
            <div class="mt-1 text-3xl font-bold">{{ online }}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4">
            <div class="text-xs uppercase tracking-wide text-slate-500">Total visitors</div>
            <div class="mt-1 text-3xl font-bold">{{ total }}</div>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
            <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-5 py-3 font-medium">Visitor</th>
                    <th class="px-5 py-3 font-medium text-right">Visits</th>
                    <th class="px-5 py-3 font-medium">First seen</th>
                    <th class="px-5 py-3 font-medium">Last seen</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for v in visitors %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-3">
                            <span class="inline-flex items-center gap-2">
                                <span class="h-2 w-2 rounded-full {{ v._online ? 'bg-emerald-500' : 'bg-slate-300' }}"></span>
                                <span class="font-medium">{{ v.name }}</span>
                            </span>
                        </td>
                        <td class="px-5 py-3 text-right text-slate-500">{{ v.visits|default(0) }}</td>
                        <td class="px-5 py-3 text-slate-500">{{ v.first_seen|fdate('d M Y, H:i') }}</td>
                        <td class="px-5 py-3 text-slate-500">{{ v.last_seen|fdate('d M Y, H:i') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="px-5 py-10 text-center text-slate-400">No visitors yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
