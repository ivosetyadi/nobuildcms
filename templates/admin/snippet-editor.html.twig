{% extends 'layouts/admin.html.twig' %}
{% block main %}
    <form method="post" action="/admin/snippets/save" class="mx-auto max-w-3xl space-y-5">
        <input type="hidden" name="id" value="{{ record.id|default('') }}">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-slate-700">Name</label>
                    <input name="name" required value="{{ record.name|default('') }}" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
                </div>
                <div>
                    <label class="text-sm font-medium text-slate-700">Key</label>
                    <input name="key" required value="{{ record.key|default('') }}" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-mono text-sm outline-none focus:border-indigo-400">
                    <p class="mt-1 text-xs text-slate-400">Call with {{ "{{ snippet('" ~ (record.key|default('key')) ~ "') }}" }}</p>
                </div>
            </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <label class="text-sm font-medium text-slate-700">Body — HTML + Tailwind + Twig</label>
            <p class="mt-1 text-xs text-slate-400">Variables passed to snippet() are available by name (e.g. {{ '{{ limit }}' }}).</p>
            <textarea name="body" rows="14" class="mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs leading-relaxed outline-none focus:border-indigo-400">{{ record.body|default('') }}</textarea>
        </div>
        <div class="flex items-center justify-end gap-3">
            <a href="/admin/snippets" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:text-slate-900">Cancel</a>
            <button class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Save</button>
        </div>
    </form>
{% endblock %}
