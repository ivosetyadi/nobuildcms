<div id="content-table" class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <table class="w-full text-sm">
        <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
            <tr>
                {% if user.role != 'viewer' %}<th class="w-10 px-5 py-3"></th>{% endif %}
                <th class="px-5 py-3 font-medium">Title</th>
                <th class="px-5 py-3 font-medium">Slug</th>
                <th class="px-5 py-3 font-medium">Status</th>
                <th class="px-5 py-3 font-medium text-right">Reads</th>
                <th class="px-5 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-type="{{ type }}">
            {% for r in rows %}
                <tr class="hover:bg-slate-50" {% if user.role != 'viewer' %}draggable="true"{% endif %} data-id="{{ r.id }}">
                    {% if user.role != 'viewer' %}<td class="px-5 py-3 whitespace-nowrap"><span class="mr-1 cursor-grab select-none text-slate-300" title="Drag to reorder">⠿</span><input type="checkbox" data-on:click="$sel = evt.target.checked ? $sel.concat('{{ r.id }}') : $sel.filter(x => x != '{{ r.id }}')"></td>{% endif %}
                    <td class="px-5 py-3">{% include 'admin/content-title-cell.html.twig' %}</td>
                    <td class="px-5 py-3 font-mono text-xs text-slate-500">{{ r.url }}</td>
                    <td class="px-5 py-3">
                        {% if user.role != 'viewer' %}
                            <button type="button" title="Toggle status" data-on:click="@post('/admin/content/{{ type }}/toggle?id={{ r.id }}')" class="rounded-full px-2 py-0.5 text-xs {{ r.status == 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' }}">{{ r.status == 'published' ? 'Published' : 'Draft' }}</button>
                        {% else %}
                            <span class="rounded-full px-2 py-0.5 text-xs {{ r.status == 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' }}">{{ r.status == 'published' ? 'Published' : 'Draft' }}</span>
                        {% endif %}
                    </td>
                    <td class="px-5 py-3 text-right text-slate-500">{{ r.reads|default(0) }}</td>
                    <td class="px-5 py-3 text-right whitespace-nowrap">
                        <a href="{{ r.url }}" target="_blank" class="text-xs text-slate-400 hover:text-slate-700">View ↗</a>
                        {% if user.role != 'viewer' %}
                            <button type="button" class="ml-3 text-xs text-indigo-600 hover:underline" data-on:click="$drawerOpen = true; @get('/admin/content/{{ type }}/edit?id={{ r.id }}')">Edit</button>
                            <button type="button" class="ml-3 text-xs text-slate-500 hover:underline" data-on:click="@post('/admin/content/{{ type }}/duplicate?id={{ r.id }}')">Duplicate</button>
                            <form method="post" action="/admin/content/{{ type }}/delete" class="ml-3 inline" onsubmit="return confirm('Delete {{ r.title }}?')">
                                <input type="hidden" name="id" value="{{ r.id }}">
                                <button class="text-xs text-rose-600 hover:underline">Delete</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="px-5 py-10 text-center text-slate-400">No {{ label|lower }} yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
