{% extends 'layouts/admin.html.twig' %}
{% block main %}
    <div data-signals="{count: 0, labq: '', labname: 'Ada Lovelace', labemail: '', labOffset: 0, show: true, prog: 20, tab: 'a'}" class="mx-auto max-w-4xl space-y-6">
        <p class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-500">Live hypermedia patterns — each runs on real PHP + JSON over Datastar SSE patches. Open the Network tab to watch the <code>datastar-patch-elements</code> events.</p>

        {# 1. Signals (client only) #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Signals</h2>
            <p class="text-sm text-slate-500">Client-side reactive state — no server round-trip.</p>
            <div class="mt-3 flex items-center gap-3">
                <button type="button" class="h-9 w-9 rounded-lg border border-slate-200 text-lg hover:bg-slate-50" data-on:click="$count--">−</button>
                <span class="w-10 text-center text-lg font-semibold" data-text="$count">0</span>
                <button type="button" class="h-9 w-9 rounded-lg border border-slate-200 text-lg hover:bg-slate-50" data-on:click="$count++">+</button>
            </div>
        </div>

        {# 2. Active Search #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Active search</h2>
            <p class="text-sm text-slate-500">Debounced input → server searches content → patches the list.</p>
            <input data-bind="labq" data-on:input__debounce.300ms="@get('/admin/lab/search')" placeholder="Try &quot;datastar&quot; or &quot;keyboard&quot;…" class="mt-3 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
            <div id="lab-search-results" class="mt-3 divide-y divide-slate-100 text-sm"></div>
        </div>

        {# 3. Click to edit #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Click to edit</h2>
            <p class="text-sm text-slate-500">Server swaps a read view ↔ an edit form.</p>
            <div id="lab-edit" class="mt-3 flex items-center gap-3">
                <span class="text-sm text-slate-700" data-text="$labname">Ada Lovelace</span>
                <button type="button" class="text-xs text-indigo-600 hover:underline" data-on:click="@get('/admin/lab/edit')">Edit</button>
            </div>
        </div>

        {# 4. Load more #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Load more</h2>
            <p class="text-sm text-slate-500">Append rows from the server (patch mode <code>append</code>).</p>
            <div id="lab-list" class="mt-3 divide-y divide-slate-100 text-sm"></div>
            <button type="button" class="mt-3 rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:bg-slate-50" data-on:click="@get('/admin/lab/more')">Load more</button>
        </div>

        {# 5. Inline validation #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Inline validation</h2>
            <p class="text-sm text-slate-500">Server validates on each keystroke.</p>
            <input data-bind="labemail" data-on:input__debounce.300ms="@post('/admin/lab/validate')" placeholder="you@example.com" class="mt-3 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-indigo-400">
            <div id="lab-validate-msg" class="mt-2 text-sm text-slate-400"></div>
        </div>

        {# 6. Toggle #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Toggle visibility</h2>
            <p class="text-sm text-slate-500">Show/hide with a single signal.</p>
            <button type="button" class="mt-3 rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:bg-slate-50" data-on:click="$show = !$show" data-text="$show ? 'Hide panel' : 'Show panel'">Hide panel</button>
            <div data-show="$show" class="mt-3 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">This panel is controlled by the <code>$show</code> signal.</div>
        </div>

        {# 7. Progress #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Progress</h2>
            <p class="text-sm text-slate-500">Drive a bar width from a signal.</p>
            <div class="mt-3 flex items-center gap-3">
                <button type="button" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:bg-slate-50" data-on:click="$prog = Math.max(0, $prog - 10)">−10</button>
                <div class="h-3 flex-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-indigo-500 transition-all" data-style="{width: $prog + '%'}"></div></div>
                <button type="button" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:bg-slate-50" data-on:click="$prog = Math.min(100, $prog + 10)">+10</button>
                <span class="w-10 text-right text-sm font-semibold" data-text="$prog + '%'">20%</span>
            </div>
        </div>

        {# 8. Tabs #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Tabs</h2>
            <div class="mt-3 flex gap-1 border-b border-slate-200">
                {% for t in [['a', 'First'], ['b', 'Second'], ['c', 'Third']] %}
                    <button type="button" data-on:click="$tab = '{{ t[0] }}'" data-class="{'border-indigo-500 text-indigo-600': $tab == '{{ t[0] }}', 'border-transparent text-slate-500': $tab != '{{ t[0] }}'}" class="border-b-2 px-3 py-2 text-sm">{{ t[1] }}</button>
                {% endfor %}
            </div>
            <div class="mt-3 text-sm text-slate-600">
                <div data-show="$tab == 'a'">Content for the first tab.</div>
                <div data-show="$tab == 'b'" style="display:none">Content for the second tab.</div>
                <div data-show="$tab == 'c'" style="display:none">Content for the third tab.</div>
            </div>
        </div>

        {# 9. Delete row #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Delete row</h2>
            <p class="text-sm text-slate-500">Server removes the row and patches the list.</p>
            <div id="lab-rows" class="mt-3 divide-y divide-slate-100 text-sm">{% include 'lab-rows.html.twig' with {rows: labrows} %}</div>
        </div>

        {# 10. Server time (polling) #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Server polling</h2>
            <p class="text-sm text-slate-500">Fetch the server clock every 2 seconds.</p>
            <div id="lab-time" data-on-interval__duration.2s="@get('/admin/lab/time')" class="mt-3 font-mono text-lg">—</div>
        </div>

        {# 11. Form submit #}
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-semibold">Form submit</h2>
            <p class="text-sm text-slate-500">Post a form; the server echoes it back.</p>
            <form class="mt-3 flex gap-2" data-on:submit="@post('/admin/lab/echo', {contentType:'form'})">
                <input name="first" placeholder="First name" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                <input name="city" placeholder="City" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                <button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Submit</button>
            </form>
            <div id="lab-echo" class="mt-3 text-sm text-slate-500"></div>
        </div>
    </div>
{% endblock %}
