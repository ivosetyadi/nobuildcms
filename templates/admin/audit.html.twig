{% extends 'layouts/admin.html.twig' %}
{% block actions %}
    <a href="/admin/audit.csv" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Export CSV</a>
{% endblock %}
{% block main %}
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
            <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-5 py-3 font-medium">Time</th>
                    <th class="px-5 py-3 font-medium">Actor</th>
                    <th class="px-5 py-3 font-medium">Action</th>
                    <th class="px-5 py-3 font-medium">Resource</th>
                    <th class="px-5 py-3 font-medium">Meta</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for e in entries %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-3 whitespace-nowrap text-slate-500">{{ e.ts|fdate('d M Y, H:i:s') }}</td>
                        <td class="px-5 py-3">{{ e.actor_name|default(e.actor) }}</td>
                        <td class="px-5 py-3"><code class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{ e.action }}</code></td>
                        <td class="px-5 py-3 font-mono text-xs text-slate-500">{{ e.resource }}</td>
                        <td class="px-5 py-3 font-mono text-xs text-slate-400">{{ e.meta ? e.meta|json_encode : '' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="px-5 py-10 text-center text-slate-400">No audit entries yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
