{% extends 'layouts/admin.html.twig' %}
{% block actions %}
    <a href="/admin/datasets/edit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">+ New dataset</a>
{% endblock %}
{% block main %}
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
            <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr><th class="px-5 py-3 font-medium">Name</th><th class="px-5 py-3 font-medium">Call</th><th class="px-5 py-3 font-medium text-right">Rows</th><th class="px-5 py-3"></th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for r in rows %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-3"><a href="/admin/datasets/edit?id={{ r.id }}" class="font-medium hover:text-indigo-600">{{ r.name }}</a></td>
                        <td class="px-5 py-3"><code class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{ "{{ data('" ~ r.key ~ "') }}" }}</code></td>
                        <td class="px-5 py-3 text-right text-slate-500">{{ r.rows|default([])|length }}</td>
                        <td class="px-5 py-3 text-right">
                            <a href="/admin/datasets/edit?id={{ r.id }}" class="text-xs text-indigo-600 hover:underline">Edit</a>
                            <form method="post" action="/admin/datasets/delete" class="ml-3 inline" onsubmit="return confirm('Delete {{ r.name }}?')">
                                <input type="hidden" name="id" value="{{ r.id }}">
                                <button class="text-xs text-rose-600 hover:underline">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="px-5 py-10 text-center text-slate-400">No datasets yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
