{
    "name": "nobuildcms/nobuildcms",
    "description": "A flat-file, no-build mini CMS & dashboard. PHP + Twig + Datastar + SSE. No database, no build step.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "cms", "php-cms", "mini-cms", "lightweight-cms", "flat-file", "flat-file-cms",
        "no-build", "no-database", "php", "twig", "datastar", "hypermedia",
        "sse", "server-sent-events", "json", "tailwindcss"
    ],
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "NoBuildCMS\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
