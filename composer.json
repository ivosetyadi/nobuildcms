{
    "name": "nobuildcms/nobuildcms",
    "description": "A flat-file, no-build mini CMS & dashboard. PHP + Twig + Datastar + SSE. No database, no build step.",
    "type": "project",
    "license": "MIT",
    "keywords": ["cms", "flat-file", "no-build", "twig", "datastar", "hypermedia", "sse", "php"],
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "NoBuildCMS\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
